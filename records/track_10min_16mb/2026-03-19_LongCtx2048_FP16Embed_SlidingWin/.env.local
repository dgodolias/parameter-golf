# -----------------------------------------------
# LOCAL SMOKE TEST - RTX 4050 (6GB VRAM)
# Usage: Copy to .env then run:
#   & ".venv\Scripts\Activate.ps1"
#   $env:TORCHDYNAMO_DISABLE="1"
#   python records/track_10min_16mb/2026-03-19_LongCtx2048_FP16Embed_SlidingWin/train_gpt.py
# -----------------------------------------------

RUN_ID=local_test

# Data (same as production — already downloaded)
DATA_PATH=./data/datasets/fineweb10B_sp1024
TOKENIZER_PATH=./data/tokenizers/fineweb_1024_bpe.model
VOCAB_SIZE=1024

# Sequence length: 512 fits in 6GB VRAM (production uses 2048)
TRAIN_SEQ_LEN=512
TRAIN_BATCH_TOKENS=4096

# Val batch size: must be small for 6GB GPU (default 524288 is way too big)
# 4096 tokens / 8 grad_accum / 512 seq_len = 1 seq per val step (safe)
VAL_BATCH_SIZE=4096

# Eval: cap at 512 seqs (~260K tokens) so eval finishes fast
# Set EVAL_STRIDE=0 to skip sliding window (much faster locally)
MAX_VAL_SEQS=512
EVAL_STRIDE=0
EVAL_BATCH_SEQS=8

# Training: 500 steps ~ 3 minutes on RTX 4050 without compile
ITERATIONS=500
WARMUP_STEPS=0
WARMDOWN_ITERS=0
VAL_LOSS_EVERY=100
TRAIN_LOG_EVERY=25

# No wallclock cap (use ITERATIONS instead)
MAX_WALLCLOCK_SECONDS=0

# Optimizer (same as production)
MATRIX_LR=0.032
TIED_EMBED_LR=0.04
SCALAR_LR=0.032
MUON_MOMENTUM=0.95
MUON_BACKEND_STEPS=5

# Architecture (same as production)
NUM_LAYERS=9
MODEL_DIM=512
NUM_HEADS=8
NUM_KV_HEADS=4
MLP_HIDDEN=960
TIE_EMBEDDINGS=1
LOGIT_SOFTCAP=30.0
ROPE_BASE=10000.0
QK_GAIN_INIT=1.5
