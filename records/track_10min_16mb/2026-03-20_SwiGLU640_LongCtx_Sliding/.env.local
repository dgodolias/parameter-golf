# -----------------------------------------------
# LOCAL SMOKE TEST - RTX 4050 (6GB VRAM)
# Usage: Copy to .env then run:
#   & ".venv\Scripts\Activate.ps1"
#   $env:TORCHDYNAMO_DISABLE="1"
#   python records/track_10min_16mb/2026-03-20_SwiGLU640_LongCtx_Sliding/train_gpt.py
# -----------------------------------------------

RUN_ID=local_test

# Data (same as production — already downloaded)
DATA_PATH=./data/datasets/fineweb10B_sp1024
TOKENIZER_PATH=./data/tokenizers/fineweb_1024_bpe.model
VOCAB_SIZE=1024

# Sequence length: 512 fits in 6GB VRAM (production uses 2048)
TRAIN_SEQ_LEN=512
TRAIN_BATCH_TOKENS=4096

# Val batch size: 65536 → 8192 tokens per rank → 16 seqs per batch → 32 batches
# (avoids the 512-batch-of-1 pattern that causes extreme Python overhead)
VAL_BATCH_SIZE=65536

# Eval: cap at 512 seqs, skip intermediate evals (only final eval matters)
MAX_VAL_SEQS=512
EVAL_STRIDE=0
EVAL_BATCH_SEQS=16

# Training: 500 steps ~ 3 minutes on RTX 4050 without compile
ITERATIONS=500
WARMUP_STEPS=0
WARMDOWN_ITERS=0
VAL_LOSS_EVERY=0
TRAIN_LOG_EVERY=25

# No wallclock cap (use ITERATIONS instead)
MAX_WALLCLOCK_SECONDS=0

# Optimizer (same as production)
MATRIX_LR=0.032
TIED_EMBED_LR=0.04
SCALAR_LR=0.032
MUON_MOMENTUM=0.95
MUON_BACKEND_STEPS=5

# Architecture — SwiGLU with hidden=640
NUM_LAYERS=9
MODEL_DIM=512
NUM_HEADS=8
NUM_KV_HEADS=4
MLP_HIDDEN=640
TIE_EMBEDDINGS=1
LOGIT_SOFTCAP=30.0
ROPE_BASE=10000.0
QK_GAIN_INIT=1.5
