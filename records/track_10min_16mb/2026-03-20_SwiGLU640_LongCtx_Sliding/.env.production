# -----------------------------------------------
# PRODUCTION RUN - 8x H100 SXM (80GB VRAM each)
# Usage: Copy to .env then:
#   torchrun --standalone --nproc_per_node=8 \
#     records/track_10min_16mb/2026-03-20_SwiGLU640_LongCtx_Sliding/train_gpt.py
# Run 3 seeds: SEED=1337, SEED=1338, SEED=1339 for significance
# -----------------------------------------------

RUN_ID=swiglu640_longctx2048_fp16emb_slide64_seed1337

# Data
DATA_PATH=./data/datasets/fineweb10B_sp1024
TOKENIZER_PATH=./data/tokenizers/fineweb_1024_bpe.model
VOCAB_SIZE=1024

# Full context + large batch (8 GPUs → grad_accum_steps=1)
TRAIN_SEQ_LEN=2048
TRAIN_BATCH_TOKENS=524288

# Full validation (all 62M tokens), sliding window stride=64
MAX_VAL_SEQS=0
EVAL_STRIDE=64
EVAL_BATCH_SEQS=1024

# 10-minute cap
ITERATIONS=20000
WARMUP_STEPS=20
WARMDOWN_ITERS=1200
VAL_LOSS_EVERY=200
TRAIN_LOG_EVERY=200
MAX_WALLCLOCK_SECONDS=600

# Optimizer
MATRIX_LR=0.032
TIED_EMBED_LR=0.04
SCALAR_LR=0.032
MUON_MOMENTUM=0.95
MUON_MOMENTUM_WARMUP_START=0.85
MUON_MOMENTUM_WARMUP_STEPS=500
MUON_BACKEND_STEPS=5
BETA1=0.9
BETA2=0.95

# Architecture — SwiGLU with hidden=640 (iso-param with relu²@960)
NUM_LAYERS=9
MODEL_DIM=512
NUM_HEADS=8
NUM_KV_HEADS=4
MLP_HIDDEN=640
TIE_EMBEDDINGS=1
LOGIT_SOFTCAP=30.0
ROPE_BASE=10000.0
QK_GAIN_INIT=1.5

# Seed — change to 1338 / 1339 for replication runs
SEED=1337
